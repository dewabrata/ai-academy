# ===== Autentikasi =====
# Pakai LANGGANAN Claude (Pro/Max): biarkan ANTHROPIC_API_KEY kosong, cukup
# sudah login lewat `claude` CLI. Pemakaian dipotong dari kuota langganan.
# Pakai API key (pay-as-you-go): isi ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=

# Path claude.exe native. Kosongkan untuk dicari otomatis.
# Di Windows, SDK menolak shim npm `claude.cmd` (risiko injeksi lewat cmd.exe),
# jadi academy.py mencari claude.exe di bin/ paket npm @anthropic-ai/claude-code.
# Isi hanya kalau pencarian otomatis gagal, mis.:
#CLAUDE_CLI_PATH=C:\Users\<nama>\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
CLAUDE_CLI_PATH=

# ===== Penyedia AI kustom (host pihak ketiga) =====
# AI_PROVIDER: claude (langganan/API key Anthropic) | openrouter | custom
#
# SYARAT host kustom: harus melayani skema ANTHROPIC (/v1/messages). Agent di
# sini berjalan di atas Claude Code, yang tidak bisa berbicara skema OpenAI
# (/v1/chat/completions). Host yang hanya OpenAI tidak bisa dipakai lewat jalur
# ini. Uji cepat: curl <host>/v1/messages dengan header x-api-key harus 200.
#
# PERHATIAN kalau modelnya bukan Claude: perhitungan biaya tidak dapat
# dipercaya, jadi plafon BUDGET_* bisa tidak pernah terpicu. Seluruh silabus
# dan materi juga dikirim ke host tersebut.
AI_PROVIDER=claude
CUSTOM_BASE_URL=https://host-anda.example/v1
CUSTOM_API_KEY=
CUSTOM_MODEL=
#CUSTOM_MODEL_OPUS=
#CUSTOM_MODEL_SONNET=
#CUSTOM_MODEL_HAIKU=

# ===== Jalur cadangan: OpenRouter =====
USE_OPENROUTER=0
OPENROUTER_API_KEY=sk-or-...

# ===== Model per peran =====
# Nilai: haiku | sonnet | opus, atau id model lengkap (mis. claude-opus-5).
# BAWAAN PROYEK INI: semua peran opus. Produksi materi ajar dinilai dari mutu
# isinya, bukan dari kecepatan, jadi tidak ada peran yang diturunkan.
# Kalau biaya perlu ditekan, MODEL_FAKTA lebih dulu: Fact-Checker membuka banyak
# halaman web sehingga token masukannya paling besar. Jangan menurunkan
# KURIKULUM/BLUEPRINT, yang hasilnya dipakai seluruh pertemuan.
MODEL_KURIKULUM=opus
MODEL_BLUEPRINT=opus
MODEL_WRITER=opus
MODEL_REVIEWER=opus
MODEL_FAKTA=opus
MODEL_SLIDE=opus
MODEL_TUGAS=opus
MODEL_EDITOR=opus
# Saat sebuah tahap GAGAL, gate menawarkan mengulang dengan model satu tingkat
# lebih tinggi (haiku -> sonnet -> opus). Karena bawaannya sudah opus, tawaran
# itu berupa ulang dengan model yang sama.

# ===== Batas biaya (USD) =====
# Plafon per tahap perencanaan.
BUDGET_KURIKULUM=2.0
BUDGET_BLUEPRINT=3.0
# Plafon PER POINT, PER PUTARAN. Satu pertemuan 10 point bisa memakai ini
# 10 x 1-3 kali, jadi angka kecil di sini berlipat cepat.
BUDGET_POINT_WRITER=4.0
BUDGET_POINT_REVIEW=1.5
BUDGET_POINT_FAKTA=1.5
# Plafon paket per pertemuan, dibangun setelah semua point siap.
BUDGET_SLIDE=3.0
BUDGET_TUGAS=4.0
BUDGET_PAKET_REVIEW=2.0
BUDGET_EDITOR=4.0
# SEMUA plafon di atas: 0 atau kosong berarti TANPA BATAS, bukan nol dolar.
# Plafon total proyek. Pipeline berhenti dan bertanya kalau terlampaui.
# Naikkan sebelum produksi nyata dengan Opus: satu pertemuan 10 point jauh
# lebih mahal daripada uji asap.
BUDGET_PROYEK=60.0

# ===== Kuota langganan =====
#   QUOTA_WAIT=auto -> tidur sampai waktu reset dari server, lalu ulang tahap
#   QUOTA_WAIT=ask  -> selalu tanya dulu di terminal
# Kalau waktu tunggu lebih dari QUOTA_WAIT_MAX_HOURS, tetap tanya dulu.
QUOTA_WAIT=auto
QUOTA_WAIT_MAX_HOURS=6

# ===== Produksi per point =====
# Panjang target satu point; nilainya masuk langsung ke prompt Writer.
# Turunkan (mis. 1-2) untuk uji coba supaya hemat kuota.
POINT_HALAMAN=10–20
# Batas putaran loop Writer -> Reviewer + Fact-Checker per point. Lewat batas
# ini point ditandai eskalasi dan dibawa ke gate pertemuan, tanpa menghentikan
# pipeline.
POINT_MAKS_PUTARAN=3
# Batas percobaan peran Tugas memperbaiki solusi lab yang gagal dieksekusi.
LAB_MAX_PERCOBAAN=3

# Bawaan opsi luaran untuk proyek BARU. Tiap proyek menyimpan salinannya sendiri
# di docs/OPSI.json, jadi mengubah ini tidak memengaruhi proyek yang sudah jalan.
#   OPSI_SLIDE=0        -> peran Slide tidak dijalankan sama sekali (hemat biaya)
#   OPSI_EKSPOR_DOCX=0  -> HANDBOOK/LATIHAN/KUNCI/PRAKTIK tidak dikonversi ke .docx
#   OPSI_EKSPOR_PPTX=0  -> SLIDE.md tidak dikonversi ke .pptx
OPSI_SLIDE=1
OPSI_EKSPOR_DOCX=1
OPSI_EKSPOR_PPTX=1

# ===== Monitoring =====
# Telegram (opsional): notifikasi tahap/gate/kuota + jawab gate dari HP.
# Buat bot via @BotFather, ambil chat_id dari @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Dashboard =====
# Bawaan 127.0.0.1: hanya bisa dibuka dari mesin ini. Ini disengaja - dashboard
# bisa menjalankan pipeline, dan peran Tugas di dalamnya punya akses Bash.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8770
# DASHBOARD_PASS kosong = dashboard dipakai tanpa login (hanya aman untuk
# 127.0.0.1). Begitu diisi, dashboard menampilkan halaman login. Wajib diisi
# kalau DASHBOARD_HOST bukan 127.0.0.1; tanpa itu dashboard menolak jalan.
# Keduanya juga bisa diisi dari halaman Pengaturan di dashboard.
DASHBOARD_USER=admin
DASHBOARD_PASS=
# Umur sesi login (jam). Sesi hilang saat dashboard di-restart.
DASHBOARD_SESI_JAM=12
# Cara paling aman mengakses dari jauh - tidak membuka port sama sekali:
#   ssh -L 8770:127.0.0.1:8770 user@server
